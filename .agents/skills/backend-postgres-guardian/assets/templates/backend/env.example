# Copia este archivo como .env (el .env NUNCA se sube al repositorio)
PUERTO=3000
NODE_ENV=development

# Conexión a PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mi_base_de_datos
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave

# JWT: el secreto va aquí y no en el código. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon_aqui_un_secreto_largo_y_aleatorio_minimo_32_caracteres
# Expira a los 25 minutos SIN interacción (se renueva con cada petición mediante cookie)
JWT_EXPIRES_IN=25m

# Configuración de Cookie de Sesión
# En desarrollo: COOKIE_SECURE=false (o true si trabajas con HTTPS local)
# En producción: COOKIE_SECURE=true obligatoriamente
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Token Anti-CSRF
CSRF_SECRET=pon_aqui_otro_secreto_largo_y_aleatorio_para_firmar_csrf

# Origen del front para CORS y validación de Origin (NUNCA usar '*')
FRONTEND_URL=http://localhost:5173
